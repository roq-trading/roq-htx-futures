{
  "name": "roq/huobi_futures/flags/WS",
  "type": "flags",
  "prefix": "ws_",
  "values": [
    {
      "name": "market_uri",
      "type": "roq/io/web/URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://api.hbdm.com/ws",
      "description": "Exchange end-point"
    },
    {
      "name": "index_uri",
      "type": "roq/io/web/URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://api.hbdm.com/ws_index",
      "description": "Exchange end-point"
    },
    {
      "name": "order_uri",
      "type": "roq/io/web/URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://api.hbdm.com/notification",
      "description": "Exchange end-point"
    },
    {
      "name": "ping_freq",
      "type": "std/nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "5s",
      "description": "Ping frequency"
    },
    {
      "name": "max_subscriptions_per_stream",
      "type": "std/uint32",
      "required": true,
      "default": 32,
      "description": "Maximum number of symbols per connection"
    },
    {
      "name": "subscribe_depth_levels",
      "type": "std/uint32",
      "default": 0,
      "description": "Depth levels"
    },
    {
      "name": "subscribe_depth_freq",
      "type": "std/nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "100ms",
      "description": "Depth update frequency"
    },
    {
      "name": "subscribe_trade_details",
      "type": "std/bool",
      "default": false,
      "description": "Report individual matches for trade summary? (bool)"
    }
  ]
}
